<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Minimal platform theme: it only paints the window before Compose draws.
      All real theming lives in Compose (Material 3).
    -->
    <style name="Theme.CodexBar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
